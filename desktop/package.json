{
  "name": "snake-3d-desktop",
  "version": "1.0.0",
  "productName": "Snake3D",
  "description": "3D 贪吃蛇桌面版",
  "author": {
    "name": "wusandao",
    "email": "wusandao@163.com"
  },
  "homepage": "https://github.com/ilses1/snake-3d",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-web.mjs",
    "start": "electron .",
    "dist": "npm run sync && electron-builder --win --x64",
    "dist:linux": "npm run sync && electron-builder --linux --x64",
    "dist:mac": "npm run sync && electron-builder --mac --x64 --arm64",
    "dist:all": "npm run sync && electron-builder --win --linux --mac --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.workbuddy.snake3d",
    "productName": "Snake3D",
    "asar": true,
    "files": [
      "main.js",
      "index.html",
      "three.module.js",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "Snake3D-Portable.exe"
    },
    "linux": {
      "icon": "icon.png",
      "category": "Game",
      "synopsis": "3D 贪吃蛇",
      "description": "用 Three.js 打造的 3D 贪吃蛇游戏",
      "maintainer": "wusandao <wusandao@163.com>",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "Snake3D-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "Snake3D-${version}-${arch}.${ext}"
    }
  }
}
